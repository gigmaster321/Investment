.env
.env.*
!.env.example

# ── Certbot (generated on the VPS, not part of the repo) ─────────────────────
certbot/

# ── Git ───────────────────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

