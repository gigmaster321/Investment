# ═══════════════════════════════════════════════════════════════════════════
# Quantum Investments — Docker environment variables
# Copy this file to .env and fill in every value before running docker compose.
# ═══════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Password for the internal postgres container.
# Also used to build DATABASE_URL automatically — only set it once here.
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# ── Session security ─────────────────────────────────────────────────────────
# Long random string used to sign session cookies. Never use the default.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_64_char_random_hex_string

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Required for email OTP verification and password reset.
# Without this, new user registration is broken in production.
# Get a free API key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# Sender address — must be a verified domain in your Resend dashboard.
EMAIL_FROM=noreply@yourdomain.com

# ── Logging ──────────────────────────────────────────────────────────────────
# Options: trace | debug | info | warn | error   (default: info)
LOG_LEVEL=info
