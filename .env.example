# ═══════════════════════════════════════════════════════════════════════════
# Quantum Investments — Production environment variables
# Copy this file to .env and fill in every value before running deploy.sh.
# ═══════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Connection string for the local PostgreSQL database.
# User and database are created by install.sh.
DATABASE_URL=postgresql://qinvest_user:YOUR_DB_PASSWORD@localhost:5432/qinvest_db

# ── Session security ─────────────────────────────────────────────────────────
# Long random string used to sign session cookies. NEVER use the default.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_64_char_random_hex_string

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Required for email OTP verification and password reset.
# Without this, new user email verification is broken in production.
# Get a free API key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# Sender address — must be verified in your Resend dashboard.
EMAIL_FROM=noreply@yourdomain.com

# ── Logging ──────────────────────────────────────────────────────────────────
# Pino log level. Options: trace | debug | info | warn | error
LOG_LEVEL=info
