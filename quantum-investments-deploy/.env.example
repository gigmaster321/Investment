# -------------------------------------------------------
# Quantum Investments – Environment Variables
# Copy this file to .env and fill in every value.
# -------------------------------------------------------

# PostgreSQL connection string (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/qinvest_db

# Secret used to sign session cookies (required)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# Port the Express API server listens on (required)
PORT=8080

# Node environment – must be "production" on live servers
NODE_ENV=production

# Resend API key – required for email OTP / password reset
RESEND_API_KEY=re_your_resend_api_key_here

# Sender address used in system emails
EMAIL_FROM=noreply@yourdomain.com

# Log verbosity: trace | debug | info | warn | error  (default: info)
LOG_LEVEL=info
